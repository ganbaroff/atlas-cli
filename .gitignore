# API keys and secrets
.env
.env~
.env.local
.env.production

# anus-cli settings
.anus/
!anus/config.yaml

# Note: .anus-clipboard/ is NOT in gitignore so ANUS can access pasted images

# Dependency directory
node_modules
bower_components

# Voice adapter local runtime (ADR-0010) — never commit venv/models/cache
adapters/voice/.venv/
adapters/voice/.cache/
adapters/voice/fixtures/*.wav
!adapters/voice/fixtures/.gitkeep
adapters/voice/**/__pycache__/
*.onnx
huggingface/
.torch/

# Editors
.idea
*.iml

# OS metadata
.DS_Store
Thumbs.db

# TypeScript build info files
*.tsbuildinfo

# Ignore built ts files
dist/

# Logs
logs/
*.log

# Runtime state
swarm-state.json
# swarm-exec runtime artifacts (durable on disk, not committed)
state/swarm-runs/
state/intake-drafts/
state/smoke-exec-graph/

# Docker folder to help skip auth refreshes
.docker

bundle

# Test report files
junit.xml
packages/*/coverage/

# Generated files
packages/cli/src/generated/
packages/core/src/generated/
.integration-tests/
packages/vscode-ide-companion/*.vsix

# ai editors
.augment/
.claude/
# Ignore Cursor local state; keep project rules trackable (Wave 2B).
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.local/
.npmrc

# Operator runs and state
operator/runs/
operator/state/operator-state.json

# Private capability notes + smoke-test scratch logs (never commit)
memory/atlas/CAPABILITIES-PRIVATE.md
smoke-log*.txt

# m10 lifecycle test sandbox (crash-leftover guard)
.m10-*/
