# Atlas CLI — API Keys (set at least one)
# Cost order (canon): NVIDIA (free) → Ollama (local) → freellmapi/Gemini (free gateway) → Groq (free/limited) → OpenRouter (paid) → Anthropic (paid)

# Free Gemini gateway (requires BOTH key and base URL — no hardcoded host in source)
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=

GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Current Anthropic default for Telegram bot.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local, set URL if running)
# OLLAMA_URL=http://localhost:11434

# Telegram bot (required for src/telegram.ts)
TELEGRAM_BOT_TOKEN=
# Creator/content bot — second Telegram bot, DIFFERENT from @volaurabot (content workflows)
TELEGRAM_CREATOR_BOT_TOKEN=

# Product analytics (optional — CLI works without it)
POSTHOG_API_KEY=
POSTHOG_HOST=

# Voice transcription (optional — bot works without it)
OPENAI_API_KEY=

# Canonical Atlas memory + Python swarm location
# Keep these pointed at the main VOLAURA repo so ANUS acts as the CLI shell,
# not as a second independent memory vault.
MEMORY_ROOT=C:\Projects\VOLAURA
VOLAURA_ROOT=C:\Projects\VOLAURA
